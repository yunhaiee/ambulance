# Gemini API key (or set GOOGLE_GENAI_USE_VERTEXAI=TRUE to use Vertex AI)
GOOGLE_API_KEY=your-google-api-key

# Host (EMS) agent model. It does KTAS medical triage, so it uses a stronger model.
# Switch to gemini-2.5-flash if speed matters more.
AGENT_MODEL=gemini-2.5-pro

# Shared token for A2A authentication. Use the same value on all five agents.
# Generate one with: openssl rand -hex 32
A2A_AUTH_TOKEN=

# Remote agent URLs (default: the four below)
# REMOTE_AGENT_URLS=http://localhost:10002,http://localhost:10003,http://localhost:10004,http://localhost:10005

# A2A call timeout in seconds / per-hospital timeout for the parallel inquiry
# A2A_CALL_TIMEOUT_S=45
# HOSPITAL_DISPATCH_TIMEOUT_S=45

# Where session/task databases and the audit log are stored (default ~/.ambulance)
# AMBULANCE_DATA_DIR=~/.ambulance

