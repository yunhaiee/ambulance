# Gemini API key (or set GOOGLE_GENAI_USE_VERTEXAI=TRUE to use Vertex AI)
GOOGLE_API_KEY=your-google-api-key

# Model for this agent (default gemini-2.5-flash-lite)
AGENT_MODEL=gemini-2.5-flash-lite

# Shared token for A2A authentication. Use the same value on all five agents.
# Generate one with: openssl rand -hex 32
A2A_AUTH_TOKEN=

# Slack, for contacting the insurer (needs the chat:write scope)
SLACK_BOT_TOKEN=xoxb-...
# Channel that receives insurance verification requests
INSURANCE_SLACK_CHANNEL_ID=your-slack-channel-id

# Where session/task databases and the audit log are stored (default ~/.ambulance)
# AMBULANCE_DATA_DIR=~/.ambulance

