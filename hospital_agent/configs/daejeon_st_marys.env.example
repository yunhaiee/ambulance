# Hospital profile: Daejeon St. Mary's Hospital. Secrets go in ../.env, not here.
HOSPITAL_AGENT_NAME=daejeon_st_marys_hospital
HOSPITAL_NAME=Daejeon St. Mary's Hospital
# Official local name, exactly as Kakao Maps lists it; used to match ER search results to this agent.
HOSPITAL_LOCAL_NAME=대전성모병원
PORT=10003

NOTION_DEPARTMENT_DB_ID=your-notion-database-id
NOTION_DOCTOR_DB_ID=your-notion-database-id
NOTION_SPACE_DB_ID=your-notion-database-id

HOSPITAL_SLACK_CHANNEL_ID=your-slack-channel-id
